# Placeholders only. Copy to .env and replace every value; never commit .env.
# Generate secrets with: openssl rand -hex 24  (LANGFUSE_ENCRYPTION_KEY: openssl rand -hex 32)

# Local services (infra/docker-compose.yml)
POSTGRES_PASSWORD=replace-me
QDRANT_API_KEY=replace-me

# Application
RAG_LAB_DATABASE_URL=postgresql://rag_lab:replace-me@127.0.0.1:5432/rag_lab
RAG_LAB_WORKSPACE_LIFETIME_HOURS=24
RAG_LAB_MAX_BODY_BYTES=1048576
RAG_LAB_DOCS_ENABLED=false
RAG_LAB_LOG_LEVEL=INFO

# Optional observability profile (docker compose --profile observability)
LANGFUSE_POSTGRES_PASSWORD=replace-me
LANGFUSE_CLICKHOUSE_PASSWORD=replace-me
LANGFUSE_REDIS_PASSWORD=replace-me
LANGFUSE_MINIO_PASSWORD=replace-me
LANGFUSE_SALT=replace-me
LANGFUSE_ENCRYPTION_KEY=replace-me-with-64-hex-characters
LANGFUSE_NEXTAUTH_SECRET=replace-me
